# ── SNS AutoJoin 백엔드 환경 변수 (운영 서버용) ──────────────────────
# 이 파일은 서버에 올릴 때 .env 로 복사하여 사용합니다.
# 절대 Git에 커밋하지 마세요!

# ── CORS 허용 도메인 (Netlify 배포 주소로 교체하세요) ─────────────────
# 예: CORS_ORIGINS=https://your-app.netlify.app
CORS_ORIGINS=https://your-app.netlify.app,http://localhost:5173

# ── 암호화 키 (아래 명령어로 새로 생성하세요) ────────────────────────
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ── JWT 서명 키 (아래 명령어로 새로 생성하세요) ───────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# ── 데이터베이스 경로 ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sns_autopost.db

# ── FastAPI 경로 접두사 (Nginx /snsauto/ 프록시와 맞춤) ──────────────
ROOT_PATH=/snsauto
