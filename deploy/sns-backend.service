# SNS AutoJoin FastAPI 백엔드 Systemd 데몬 서비스 설정
# 설치 방법:
#   sudo cp sns-backend.service /etc/systemd/system/sns-backend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sns-backend

[Unit]
Description=SNS AutoJoin FastAPI Backend Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sns_auto_backend
# litellm-env 가상환경 파이썬 재사용 (FastAPI/Uvicorn 이미 설치됨)
ExecStart=/home/ubuntu/litellm-env/bin/python3 -m uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --root-path /snsauto
EnvironmentFile=/home/ubuntu/sns_auto_backend/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
